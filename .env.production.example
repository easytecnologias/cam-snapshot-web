# Copy this file to .env.production on the production server.
# Do not commit .env.production.

TZ=America/Sao_Paulo
APP_ENV=production
ENABLE_DOCS=0
AUTH_REQUIRED=1
AUTH_LEGACY_OPEN=0
ENABLE_LEGACY_STATE_IMPORT=0

# Pin this to an immutable production image tag before go-live.
CAM_SNAPSHOT_IMAGE=sightops-prod-api:20260810-initial

# Public ports. These do not conflict with the homologation stack.
SIGHTOPS_HTTP_PORT=8088
SIGHTOPS_PUBLIC_HTTP_PORT=80
SIGHTOPS_POSTGRES_PORT=5435
ZABBIX_WEB_PORT=8089
ZABBIX_SERVER_PORT=10052
GRAFANA_PORT=3002

# Replace with production URL/domain when defined.
ALLOWED_ORIGINS=http://10.10.12.7,http://10.10.12.7:8088,http://sightops.easytecnologias.com.br,https://sightops.easytecnologias.com.br,http://sigthops.easytecnologias.com.br,https://sigthops.easytecnologias.com.br
TRUSTED_PROXIES=127.0.0.1

# SightOps production database.
SIGHTOPS_DB=sightops_prod
SIGHTOPS_DB_USER=sightops_prod
SIGHTOPS_DB_PASSWORD=change-this-sightops-prod-password

# Zabbix production database.
ZABBIX_DB=zabbix_prod
ZABBIX_DB_USER=zabbix_prod
ZABBIX_DB_PASSWORD=change-this-zabbix-prod-password

# Zabbix tuning.
ZBX_CACHESIZE=256M
ZBX_HISTORYCACHESIZE=128M
ZBX_TRENDCACHESIZE=128M
ZBX_VALUECACHESIZE=128M
ZABBIX_AGENT_HOSTNAME=sightops-prod-docker-host

# Grafana production admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-prod-password
GRAFANA_INSTALL_PLUGINS=alexanderzobnin-zabbix-app

# External integrations.
IMGBB_API_KEY=
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.5-flash

# Long random value. Losing this breaks decryption of saved operational secrets.
SIGHTOPS_SECRET_KEY=change-this-long-random-secret-key
